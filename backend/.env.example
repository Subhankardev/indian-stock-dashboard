# Backend settings. Copy this file to backend/.env and fill it in:
#     cp .env.example .env
# .env is gitignored - never commit it. Restart the backend after editing.
# A variable exported in your terminal overrides the value here;
# http://localhost:8000/api/config shows what the backend actually uses.

# --- Market data -------------------------------------------------------------
# upstox (default) or nse
DATA_SOURCE=upstox
# Upstox access token, without quotes. A regular token expires every day; an
# "extended" token lasts about a year - keep it secret like a password.
# Needed for the live feed and option chain; optional for daily analysis.
UPSTOX_ACCESS_TOKEN=
# How many expired monthly futures contracts to pull for OI history
UPSTOX_MAX_EXPIRED=24

# One-click "Log in with Upstox" (recommended): from your app in the Upstox
# developer console. Register this exact redirect URL in the app's settings:
#     http://localhost:8000/api/upstox/callback
# Then each morning click "Log in with Upstox" in the dashboard; the day's
# UPSTOX_ACCESS_TOKEN is saved above automatically.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URI=http://localhost:8000/api/upstox/callback

# --- Telegram alerts (optional) ----------------------------------------------
# Bot token from @BotFather, and your chat id from
# http://localhost:8000/api/alerts/telegram/chats
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which alerts go to Telegram: any of forming,confirmed,faded,test
TELEGRAM_ALERT_KINDS=forming,confirmed,faded,test

# --- Alert scanner -----------------------------------------------------------
# ALERTS_ENABLED=1
# ALERTS_INTERVAL=60
