# Copy to .env (never commit the real file) and load it before starting the backend.
# upstox (default) or nse
DATA_SOURCE=upstox
# Optional. Daily OAuth token from your Upstox app; enables expired-futures OI history.
UPSTOX_ACCESS_TOKEN=
# How many expired monthly futures contracts to pull for OI history
UPSTOX_MAX_EXPIRED=24
